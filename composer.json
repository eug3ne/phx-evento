{
    "name": "phx-eventorama/evento",
    "type": "project",
    "description": "Evento - Headless Event Management, Ticketing, Settlement, and Analytics Platform",
    "keywords": ["events", "ticketing", "analytics", "json-api", "laravel"],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "brick/money": "^0.15.2",
        "dedoc/scramble": "^0.13.39",
        "doctrine/dbal": "^3.6 || ^4.0",
        "guzzlehttp/guzzle": "^7.8",
        "hashids/hashids": "^4.1 || ^5.0",
        "laravel-json-api/laravel": "^5.3",
        "laravel/cashier": "^15.0 || ^16.0",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13.11",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "sendgrid/sendgrid": "^8.1",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/icalendar-generator": "^3.0",
        "spatie/laravel-data": "^4.15",
        "spatie/laravel-google-calendar": "^3.8",
        "spatie/laravel-permission": "^6.0 || ^7.0",
        "spatie/laravel-webhook-server": "^3.8",
        "stripe/stripe-php": "^17.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel-json-api/testing": "^3.0 || ^4.0",
        "laravel/pint": "^1.20",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Core/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "@php artisan test"
        ],
        "lint": [
            "./vendor/bin/pint --test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

